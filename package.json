{
  "name": "vesuvia-search",
  "version": "3.0.0",
  "description": "Live train times for the EAV network around Naples: Circumvesuviana, Cumana and Circumflegrea. Journey planner, live boards, installable PWA.",
  "private": false,
  "author": {
    "name": "Lucio Cocorullo",
    "url": "https://creja.it"
  },
  "license": "MIT",
  "homepage": "https://vesuvia-search.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/luciococorullo/vesuvia-search.git"
  },
  "bugs": {
    "url": "https://github.com/luciococorullo/vesuvia-search/issues"
  },
  "keywords": [
    "circumvesuviana",
    "cumana",
    "circumflegrea",
    "eav",
    "train",
    "timetable",
    "naples",
    "sorrento",
    "campania",
    "italy",
    "pwa",
    "nextjs",
    "typescript"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "generate-icons": "node scripts/generate-icons.js",
    "pwa:build": "npm run generate-icons && npm run build",
    "pwa:serve": "npm run pwa:build && npm start",
    "clean:icons": "rm -rf public/icons/*.svg",
    "clean": "rm -rf .next out build dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.19",
    "@vercel/analytics": "^1.6.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "^16.4.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  }
}
